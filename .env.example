SERVICE_SHARED_SECRET=        # required: header auth (x-service-secret) for all endpoints
OPENAI_API_KEY=               # required for best results: intent parse + ranking. Falls back to a heuristic parser if absent.
OPENAI_MODEL=gpt-4o-mini      # optional: override the OpenAI model used for intent parsing
APOLLO_API_KEY=               # optional: enriches results via Apollo; falls back to curated dataset if absent
COLDREACH_DRAFT_URL=          # optional: ColdReach external draft endpoint for handoff
COLDREACH_SHARED_SECRET=      # optional: auth for the ColdReach handoff
