# Copy to .env.local and fill in. All keys are OPTIONAL for the demo:
# every layer degrades to deterministic fallback data when a key is absent,
# so the full flow runs end-to-end with zero keys (demo-safe by design).

# Shared-secret header auth on every /v1 endpoint.
# If unset, the service runs in OPEN demo mode (auth skipped) so the local demo
# UI can call its own endpoints without configuration. Set it to require the
# x-service-secret header (matches production).
SERVICE_SHARED_SECRET=

# OpenAI: intent parsing (/v1/narrow) + hook extraction / angle generation.
# Falls back to deterministic heuristics when missing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Fiber AI: primary social/data source (recent LinkedIn/X posts, people/company
# search, contact waterfall). Falls back to news/Apollo/curated dataset when missing.
FIBER_API_KEY=
FIBER_API_BASE_URL=https://api.fiber.ai

# Apollo: bio/contact fallback when Fiber social is thin; also enriches /v1/narrow.
APOLLO_API_KEY=

# ColdReach handoff (optional): where to hand a chosen prospect for drafting/send.
COLDREACH_DRAFT_URL=
COLDREACH_SHARED_SECRET=

# Thaw <-> ColdReach integration (docs/integration.md). Same secret value in both
# repos; COLDREACH_URL is ColdReach's base URL for /api/external/* + deep links.
INTEGRATION_SHARED_SECRET=
COLDREACH_URL=
